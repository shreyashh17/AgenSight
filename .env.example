# ── InsightForge Environment Configuration ──

# AI & Search API Keys (Optional if running in Demo Simulation Mode)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here
TAVILY_API_KEY=tvly-your-tavily-api-key-here

# Database Configuration (SQLite default; PostgreSQL supported)
DATABASE_URL=sqlite+aiosqlite:///./insightforge.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/insightforge

# Backend Settings
ENV=development
DEBUG=True
DEFAULT_MODEL=gpt-4o-mini

# Frontend Environment Variables
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
